{
  "name": "expo-preflight",
  "version": "0.1.0",
  "description": "Statically audit an Expo / React Native project before eas build or eas update.",
  "keywords": [
    "expo",
    "react-native",
    "eas",
    "eas-build",
    "eas-update",
    "preflight",
    "lint",
    "ci",
    "app-store",
    "play-store",
    "cli"
  ],
  "author": "Attay Rasool (AttayR)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AttayR/expo-preflight.git"
  },
  "homepage": "https://github.com/AttayR/expo-preflight#readme",
  "bugs": {
    "url": "https://github.com/AttayR/expo-preflight/issues"
  },
  "type": "module",
  "bin": {
    "expo-preflight": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "preflight": "node dist/cli.js"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
